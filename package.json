{
  "name": "forge",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Local web engineering-agent platform with deterministic guardrails and durable sessions.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --enable-source-maps --import tsx/esm src/cli/serve.ts",
    "bench": "node --enable-source-maps --import tsx/esm src/cli/benchmark.ts",
    "reliability": "node --enable-source-maps --import tsx/esm src/cli/reliability.ts",
    "real-bench": "node --enable-source-maps --import tsx/esm src/cli/real-bench.ts",
    "gen:seams": "tsx scripts/gen-capability-seams.ts"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "node-pty": "^1.2.0-beta.15",
    "tsx": "4.22.1"
  },
  "workspaces": [
    "pi/packages/agent",
    "pi/packages/ai",
    "pi/packages/coding-agent",
    "pi/packages/client",
    "pi/packages/protocol",
    "pi/packages/telemetry",
    "pi/packages/tui"
  ]
}
